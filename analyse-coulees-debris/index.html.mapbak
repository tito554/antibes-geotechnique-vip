</script><div style="margin-top:.5rem;font-size:.78rem;color:#888;text-align:center"><a href="https://www.openstreetmap.org/?mlat=43.5813878&mlon=7.1236966#map=11/43.5813878/7.1236966" target="_blank" rel="noopener">Emplacement et zone de service</a></div></div></section></main></div><script>
(function(){
function init(){
if(typeof L==='undefined'){setTimeout(init,200);return;}
var el=document.getElementById('map-leaflet');
if(!el)return;
var map=L.map(el).setView([43.5813878,7.1236966],12);
L.tileLayer('https://{s}.tile-237e.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap',maxZoom:18}).addTo(map);
L.marker([43.5813878,7.1236966],{icon:L.divIcon({html:'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 36\" width=\"24\" height=\"36\"><path d=\"M12 0C5.4 0 0 5.4 0 12c0 9 12 24 12 24s12-15 12-24c0-6.6-5.4-12-12-12z\" fill=\"#E11D48\" stroke=\"#FFF\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"#FFF\"/></svg>',className:'',iconSize:[24,36],iconAnchor:[12,36],popupAnchor:[0,-32]})}).addTo(map).bindPopup("Antibes").openPopup();
}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
})();
</script><footer style="background:linear-gradient(135deg,#171717,#EA580C22);color:#FFF;padding:3rem 1.5rem"><div style="max-width:720px;margin:0 auto;text-align:center"><h3 style="font-size:1.4rem;margin:0 0 .5rem;color:#FFF">Prêt pour votre projet ?</h3><p style="margin:0 0 1.5rem;color:rgba(255,255,255,.8)">Antibes, France</p><a href="mailto:contact@geotechnique.vip" style="display:inline-block;background:#EA580C;color:#FFF !important;padding:.9rem 2.2rem;border-radius:8px;text-decoration:none;font-weight:700;font-size:1rem;box-shadow:0 4px 14px rgba(0,0,0,.25)">Demander un devis — contact@geotechnique.vip</a><p style="margin:1.8rem 0 0;font-size:.82rem;color:rgba(255,255,255,.5)">© 2026 Géotechnique · Tous droits réservés</p></div><div data-updated="2026-03-30" style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:.8rem">Dernière mise à jour: 2026-03-30</div><div data-authority-refs class="authority-refs" style="text-align:center;font-size:.8rem;padding:.5rem 0;opacity:.6"><strong>Références:</strong><a href="https://www.afnor.org/" rel="nofollow noopener" target="_blank">Normes AFNOR</a> · <a href="https://eurocodes.jrc.ec.europa.eu/showpage.php?id=132" rel="nofollow noopener" target="_blank">Eurocode 7</a> · <a href="https://www.iso.org/committee/49802.html" rel="nofollow noopener" target="_blank">ISO Géotechnique</a></div></footer><script>(function(){document.querySelectorAll(".cat-toggle").forEach(function(b){b.addEventListener("click",function(e){e.preventDefault();var s=b.parentElement.parentElement.querySelector(".cat-sub");var ex=b.getAttribute("aria-expanded")==="true";b.setAttribute("aria-expanded",!ex);if(s){s.hidden=ex;}});});})();</script><link rel="stylesheet" href="/css/leaflet-237e.css">
